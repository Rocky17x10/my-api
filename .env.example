# Copy to .env and fill in. The app refuses to start if a required value is missing or invalid
# (see src/config/env.validation.ts). Keep comments on their own lines.

NODE_ENV=development
PORT=3001

# mysql or mariadb: must match the server (XAMPP ships MariaDB).
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
# Required. Older .env files may use DB_PASSWORD instead of DATABASE_PASSWORD.
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=

# Required, at least 32 characters. Older .env files may use JWT_SECRET.
JWT_ACCESS_SECRET=
# Minutes (1-60). The browser refreshes it silently with the refresh token.
JWT_ACCESS_TTL_MINUTES=15
# Days (1-30). A user who is away longer has to log in again.
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of browser origins allowed to call the API.
FRONTEND_URL=http://localhost:3000

# Optional. Domain for the auth cookies, e.g. example.com when the app is on app.example.com
# and the API on api.example.com. Leave commented out for host-only cookies (local dev).
# COOKIE_DOMAIN=example.com

# Optional. Set when the API runs behind a reverse proxy / load balancer, so the client IP
# (used by login throttling) is read from X-Forwarded-For: a hop count (1 = one proxy in front)
# or an Express preset such as loopback. Leave commented out when clients connect directly.
# TRUST_PROXY=1

# bcrypt cost factor, 10-15.
BCRYPT_SALT_ROUNDS=12

# Optional NestJS Observe telemetry. Leave empty to disable.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Used only by `npm run seed` (see docs/DATABASE_MIGRATIONS.md). Prefer passing them on the
# command line for that one run instead of keeping passwords in this file.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=Super Admin
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
